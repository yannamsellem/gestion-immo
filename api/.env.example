# PostgreSQL database configuration
POSTGRES_DB=gestion_immo
POSTGRES_USER=gestion_immo
POSTGRES_PASSWORD=changeme_local_dev_password
DATABASE_URL=postgres://gestion_immo:changeme_local_dev_password@localhost:5432/gestion_immo?sslmode=disable

# Ed25519 JWT signing keys (run `make keys` or `go run ./cmd token keygen` to populate ./keys)
JWT_KEYS_DIR=./keys
JWT_KID=local-dev-key

# Cloudflare R2 S3-compatible object storage (dummy placeholders for local development)
R2_ENDPOINT=https://00000000000000000000000000000000.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=dummy-r2-access-key-id
R2_SECRET_ACCESS_KEY=dummy-r2-secret-access-key
R2_BUCKET_NAME=gestion-immo-local
R2_BACKUP_BUCKET_NAME=gestion-immo-backups-local

# Gotenberg HTML/Office-to-PDF rendering engine
GOTENBERG_URL=http://localhost:3000

# Application runtime settings
ENABLE_OPEN_BANKING=false
PORT=8080

# Cloudflare Zero Trust Tunnel token (only required when running docker-compose cloudflared service)
CLOUDFLARE_TUNNEL_TOKEN=dummy-cloudflare-tunnel-token

# Super Admin bootstrap credentials (used by `make bootstrap` and `make token`)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=changeme_super_admin_password
